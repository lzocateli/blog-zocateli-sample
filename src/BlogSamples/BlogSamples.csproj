<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logging / Telemetria (Artigo 8) -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />

    <!-- Autenticação (Artigos 3, 5, 13) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.12" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.8.3" />

    <!-- Entity Framework Core (Artigos 4, 9, 10, 11, 14) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.70" />

    <!-- Bulk Insert (Artigo 4) -->
    <PackageReference Include="EFCore.BulkExtensions" Version="8.1.3" />

    <!-- Mensageria (Artigo 4) -->
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.18.4" />

    <!-- Resiliência (Artigo 7) -->
    <PackageReference Include="Polly" Version="8.5.2" />

    <!-- YARP Reverse Proxy — BFF (Artigo 13) -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />

    <!-- OpenAPI / Swagger (Artigo 9 — PaginacaoExtensions) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.12" />
  </ItemGroup>

</Project>
