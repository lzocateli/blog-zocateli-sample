<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scripting — DotnetRunSingleFile são scripts standalone para "dotnet run arquivo.cs"
         e NÃO devem ser compilados como parte deste projeto web. -->
    <Compile Remove="Scripting/DotnetRunSingleFile/**" />
    <None Include="Scripting/DotnetRunSingleFile/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging / Telemetria (Artigo 8) -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />

    <!-- Autenticação (Artigos 3, 5, 13) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.1" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.8.3" />

    <!-- Entity Framework Core (Artigos 4, 9, 10, 11, 14) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26100" />

    <!-- Bulk Insert (Artigo 4) -->
    <PackageReference Include="EFCore.BulkExtensions" Version="10.0.1" />

    <!-- Mensageria (Artigo 4) -->
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.18.4" />

    <!-- Resiliência (Artigo 7) -->
    <PackageReference Include="Polly" Version="8.5.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />

    <!-- YARP Reverse Proxy — BFF (Artigo 13) -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />

    <!-- OpenAPI / Swagger (Artigo 9 — PaginacaoExtensions) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
  </ItemGroup>

</Project>
