<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="nuget-test" value="https://int.nugettest.org/api/v2" />
    <add key="azure-artifacts" value="https://pkgs.dev.azure.com/<ORG>/<PROJECT>/_packaging/<FEED>/nuget/v3/index.json" />
    <add key="github-packages" value="https://nuget.pkg.github.com/<ORGANIZATION>/index.json" />
  </packageSources>
</configuration>
